{
  "name": "courseo",
  "version": "0.1.0",
  "private": true,
  "description": "Courseo — organize, share, and watch your self-hosted courses.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12 <23"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @courseo/server --filter @courseo/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "better-sqlite3",
      "esbuild"
    ]
  }
}
