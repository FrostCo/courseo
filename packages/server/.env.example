# Copy to .env for local development (loaded by `pnpm dev`).
PORT=3000
DATA_DIR=./data
LIBRARIES_ROOT=./dev-libraries
SESSION_TTL_DAYS=30

# Only behind a trusted reverse proxy:
#TRUST_PROXY=true
#SSO_USER_HEADER=Remote-User

# Set in Docker to the built web UI; unset in dev (Vite serves the UI).
#WEB_DIST=/app/web
