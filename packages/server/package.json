{
  "name": "@courseo/server",
  "version": "0.1.0",
  "private": true,
  "description": "Courseo API server — Express + SQLite, serves the built web UI.",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --external:express --external:better-sqlite3 --external:argon2 --outfile=dist/index.js",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@courseo/shared": "workspace:*",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "cookie": "^2.0.1",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
